{
	"name": "Dora ROS Developement",
	// Elméletben van egy
	"image": "dora-test:prod",
	"workspaceMount": "source=${localWorkspaceFolder},target=/root/dora-ros,type=bind",
	"workspaceFolder": "/root/dora-ros",

	"runArgs": [
		// SELinux ne sírjon
		"--security-opt",
		"label=disable",

		// Legyen elnevezve
		"--name",
		"dora-devcon",

		// Git config 1
		"-v",
		"${localEnv:HOME}/.gitconfig:/etc/gitconfig:ro",

		// SSH credentials
		"-v",
		"${localEnv:HOME}/.ssh/id_rsa:/root/.ssh/id_rsa:ro",
		"-v",
		"${localEnv:HOME}/.ssh/id_rsa.pub:/root/.ssh/id_rsa.pub:ro"
	],

	// git trust?
	"postStartCommand": "git config --global --add safe.directory /root/dora-ros"

